{
  "name": "josh-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dupes": "jscpd",
    "unused": "knip",
    "size": "size-limit",
    "check:locked": "node scripts/check-locked.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:components": "node scripts/check-components.mjs",
    "loc": "node scripts/loc.mjs",
    "verify": "npm run lint && npm run lint:tokens && npm run typecheck && npm run test && npm run dupes && npm run unused && npm run check:components"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.2",
    "jscpd": "^5.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.44.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
